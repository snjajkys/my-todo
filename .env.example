# Supabase → 대시보드 상단 Connect → Connection string 에서 복사한다.
# 두 URL 모두 호스트가 pooler.supabase.com 이어야 한다.
# (db.<ref>.supabase.co 로 시작하는 Direct connection 은 IPv6 전용이라 Vercel 에서 못 쓴다)

# 앱 런타임용 - Transaction pooler (포트 6543)
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"

# prisma migrate 용 - Session pooler (포트 5432)
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# 접근 제어
# 계정과 비밀번호는 /signup 에서 각자 만들고, 비밀번호는 DB 에 해시로만 저장된다.

# 세션 쿠키 서명 키.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` 로 만든다.
# 없으면 앱 전체가 막히고, 바꾸면 기존 로그인 세션이 모두 무효가 된다.
AUTH_SECRET="<32바이트-랜덤-문자열>"

# 가입에 필요한 초대 코드. 이 값을 아는 사람만 계정을 만들 수 있다.
# 비어 있으면 가입이 열리는 게 아니라 아예 막힌다.
# 값을 바꾸면 그 시점부터 예전 코드로는 가입할 수 없다.
INVITE_CODE="<테스터에게-알려줄-코드>"
