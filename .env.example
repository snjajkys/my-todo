# Supabase → 대시보드 상단 Connect → Connection string 에서 복사한다.
# 두 URL 모두 호스트가 pooler.supabase.com 이어야 한다.
# (db.<ref>.supabase.co 로 시작하는 Direct connection 은 IPv6 전용이라 Vercel 에서 못 쓴다)

# 앱 런타임용 - Transaction pooler (포트 6543)
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"

# prisma migrate 용 - Session pooler (포트 5432)
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# 접근 제어 (둘 다 없으면 앱 전체가 로그인 화면에서 막힌다)

# 로그인 화면에 입력할 비밀번호
APP_PASSWORD="<원하는-비밀번호>"

# 세션 쿠키 서명 키. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` 로 만든다.
# 이 값을 바꾸면 기존 로그인 세션이 모두 무효가 된다.
AUTH_SECRET="<32바이트-랜덤-문자열>"
