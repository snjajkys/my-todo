# Supabase → 대시보드 상단 Connect → Connection string 에서 복사한다.
# 두 URL 모두 호스트가 pooler.supabase.com 이어야 한다.
# (db.<ref>.supabase.co 로 시작하는 Direct connection 은 IPv6 전용이라 Vercel 에서 못 쓴다)

# 앱 런타임용 - Transaction pooler (포트 6543)
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"

# prisma migrate 용 - Session pooler (포트 5432)
DIRECT_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# 접근 제어
# 계정과 비밀번호는 /signup 에서 각자 만들고, 비밀번호는 DB 에 해시로만 저장된다.

# 세션 쿠키 서명 키.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` 로 만든다.
# 없으면 앱 전체가 막히고, 바꾸면 기존 로그인 세션이 모두 무효가 된다.
AUTH_SECRET="<32바이트-랜덤-문자열>"

# 가입에 필요한 초대 코드. 이 값을 아는 사람만 계정을 만들 수 있다.
# 비어 있으면 가입이 열리는 게 아니라 아예 막힌다.
# 값을 바꾸면 그 시점부터 예전 코드로는 가입할 수 없다.
INVITE_CODE="<테스터에게-알려줄-코드>"

# /admin 에서 남의 비밀번호를 재설정할 수 있는 계정의 아이디.
# 여기 적힌 아이디로 가입된 계정이 관리자가 된다. 비어 있으면 관리 기능이 닫힌다.
# DB 플래그가 아니라 환경변수로 둔 것은, DB 에 접근한 사람이 스스로를
# 관리자로 올리지 못하게 하기 위해서다.
ADMIN_USERNAME="<관리자로-쓸-아이디>"

# ── 아침 알림 (웹 푸시) ──────────────────────────────
# 없으면 알림 기능만 꺼지고 나머지는 그대로 돌아간다.

# 푸시 서비스에 "이 서버가 보낸 게 맞다"를 증명하는 키 한 쌍.
# `node -e "console.log(require('web-push').generateVAPIDKeys())"` 로 만든다.
# 한 번 정하면 바꾸지 않는다. 바꾸면 기기마다 알림을 다시 켜야 한다.
VAPID_PUBLIC_KEY="<공개키>"
VAPID_PRIVATE_KEY="<개인키>"

# 푸시 서비스가 문제가 생겼을 때 찾아올 창구. mailto: 또는 https: 주소.
# 비워 두면 앱 주소를 쓴다.
VAPID_SUBJECT="https://my-todo-diary.vercel.app"

# 크론이 /api/push/send 를 부를 때 쓰는 비밀값.
# 이 이름으로 환경변수를 만들어 두면 Vercel 이 크론 요청에 자동으로 실어 준다.
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"` 로 만든다.
# 비어 있으면 아침 알림이 발송되지 않는다 (막힌 채로 둔다).
CRON_SECRET="<32바이트-랜덤-문자열>"
