// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 각자 자기 다이어리를 쓴다. 가입은 초대 코드를 아는 사람만 할 수 있다.
model User {
  id Int @id @default(autoincrement())
  /// 로그인 아이디. 대소문자 구분 없이 하나뿐이어야 하므로 소문자로만 저장한다.
  username     String   @unique
  /// scrypt 해시. `<salt(hex)>:<derivedKey(hex)>` 형식으로 저장한다.
  passwordHash String
  /// 비밀번호를 마지막으로 바꾼 시각. 이 시각보다 먼저 발급된 세션은 무효로 본다.
  /// 세션 토큰은 비밀번호와 무관하게 서명되므로, 이 값이 없으면 비밀번호를 바꿔도
  /// 다른 기기에 남은 로그인이 그대로 살아 있게 된다.
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  todos             Todo[]
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  /// "TODAY"(오늘 할 일) | "PERIOD"(기간을 두고 할 일)
  /// SQLite 시절부터 문자열로 저장하고 API 에서 검증해 왔다.
  /// PostgreSQL 로 옮겼으므로 enum 으로 바꿀 수 있지만, 별도 마이그레이션으로 처리한다.
  type      String   @default("TODAY")
  /// 날짜만 의미가 있으므로 UTC 자정으로 저장한다.
  /// TODAY: 그 할 일의 기준 날짜(등록한 날). endDate 는 사용하지 않는다.
  /// PERIOD: 시작일 / 종료일.
  startDate DateTime?
  endDate   DateTime?
  /// 완료 처리한 시각. 완료를 해제하면 null 로 되돌린다.
  /// TODAY 할 일이 "언제 완료됐는지" 판단해 지난 날짜 항목을 목록에서 내리는 데 쓴다.
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 이 할 일의 주인. 목록 조회부터 수정/삭제까지 모든 질의를 이 값으로 한정한다.
  /// 빠뜨리면 id 만 바꿔가며 남의 할 일에 접근할 수 있게 된다.
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
