// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 앱 접근 비밀번호. 사용자가 첫 화면에서 직접 등록한다.
/// 사용자가 한 명뿐이므로 행은 항상 최대 1개이고, id 는 1 로 고정한다.
model AppAuth {
  id           Int      @id @default(1)
  /// scrypt 해시. `<salt(hex)>:<derivedKey(hex)>` 형식으로 저장한다.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  /// "TODAY"(오늘 할 일) | "PERIOD"(기간을 두고 할 일)
  /// SQLite 시절부터 문자열로 저장하고 API 에서 검증해 왔다.
  /// PostgreSQL 로 옮겼으므로 enum 으로 바꿀 수 있지만, 별도 마이그레이션으로 처리한다.
  type      String   @default("TODAY")
  /// 날짜만 의미가 있으므로 UTC 자정으로 저장한다.
  /// TODAY: 그 할 일의 기준 날짜(등록한 날). endDate 는 사용하지 않는다.
  /// PERIOD: 시작일 / 종료일.
  startDate DateTime?
  endDate   DateTime?
  /// 완료 처리한 시각. 완료를 해제하면 null 로 되돌린다.
  /// TODAY 할 일이 "언제 완료됐는지" 판단해 지난 날짜 항목을 목록에서 내리는 데 쓴다.
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
