// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 각자 자기 다이어리를 쓴다. 가입은 초대 코드를 아는 사람만 할 수 있다.
model User {
  id Int @id @default(autoincrement())
  /// 로그인 아이디. 대소문자 구분 없이 하나뿐이어야 하므로 소문자로만 저장한다.
  username     String   @unique
  /// scrypt 해시. `<salt(hex)>:<derivedKey(hex)>` 형식으로 저장한다.
  passwordHash String
  /// 비밀번호를 마지막으로 바꾼 시각. 이 시각보다 먼저 발급된 세션은 무효로 본다.
  /// 세션 토큰은 비밀번호와 무관하게 서명되므로, 이 값이 없으면 비밀번호를 바꿔도
  /// 다른 기기에 남은 로그인이 그대로 살아 있게 된다.
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  todos             Todo[]
  pushSubscriptions PushSubscription[]
  customHolidays    CustomHoliday[]
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  /// "TODAY"(오늘 할 일) | "PERIOD"(기간을 두고 할 일)
  /// SQLite 시절부터 문자열로 저장하고 API 에서 검증해 왔다.
  /// PostgreSQL 로 옮겼으므로 enum 으로 바꿀 수 있지만, 별도 마이그레이션으로 처리한다.
  type      String   @default("TODAY")
  /// 중요도. 기본은 보통.
  priority  String   @default("MEDIUM")
  /// 날짜만 의미가 있으므로 UTC 자정으로 저장한다.
  /// TODAY: 그 할 일의 기준 날짜(등록한 날). endDate 는 사용하지 않는다.
  /// PERIOD: 시작일 / 종료일.
  startDate DateTime?
  endDate   DateTime?
  /// 완료 처리한 시각. 완료를 해제하면 null 로 되돌린다.
  /// TODAY 할 일이 "언제 완료됐는지" 판단해 지난 날짜 항목을 목록에서 내리는 데 쓴다.
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 이 할 일의 주인. 목록 조회부터 수정/삭제까지 모든 질의를 이 값으로 한정한다.
  /// 빠뜨리면 id 만 바꿔가며 남의 할 일에 접근할 수 있게 된다.
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 아침 알림을 받을 기기 한 대. 브라우저가 내주는 구독 정보를 그대로 담는다.
///
/// 알림 켜기/끄기는 이 행이 있느냐 없느냐로 정한다. 따로 on/off 열을 두지 않는 것은
/// 구독이 기기마다 따로 발급되기 때문이다. 폰에서 껐다고 태블릿까지 꺼지면 곤란하고,
/// 반대로 열만 꺼두고 구독을 남기면 브라우저가 이미 버린 구독을 계속 들고 있게 된다.
model PushSubscription {
  id Int @id @default(autoincrement())
  /// 푸시 서비스가 발급한 이 기기의 주소. 같은 기기가 다시 구독하면 같은 값이 오므로
  /// 유일 키로 두고 덮어쓴다. 기기를 바꾸거나 브라우저 데이터를 지우면 새 값이 발급된다.
  endpoint String @unique
  /// 메시지를 암호화할 때 쓰는 기기 공개키와 인증 비밀. 브라우저가 준 값 그대로 보관한다.
  p256dh String
  auth   String
  createdAt DateTime @default(now())

  /// 이 기기로 누구의 할 일을 보낼지. 계정이 사라지면 구독도 함께 지운다.
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/* ── 휴일 ────────────────────────────────────────────
   날짜를 Todo 처럼 DateTime 이 아니라 "YYYY-MM-DD" 문자열로 두었다.
   휴일은 시각이 아예 없는 순수한 달력 날짜이고, 화면도 이 형식으로 비교한다.
   DateTime 으로 두면 저장할 때 자정을 붙였다가 읽을 때 떼는 일이 매번 생기고,
   그 왕복에서 하루가 밀리는 사고가 이 앱에서 이미 여러 번 있었다. */

/// 법정공휴일. 공공데이터포털(한국천문연구원 특일 정보)에서 받아 둔 것이라
/// 특정 사용자의 것이 아니고 모두에게 똑같이 보인다.
model PublicHoliday {
  /// "YYYY-MM-DD"
  date String @id
  /// "삼일절" · "대체공휴일" 처럼 API 가 주는 이름 그대로
  name String
}

/// 연도별 동기화 기록.
///
/// 임시공휴일은 연중에 갑자기 지정되므로 한 번 받아 두고 끝낼 수 없다.
/// 마지막으로 받아 온 때를 적어 두고, 오래됐으면 다시 받는다.
model HolidaySync {
  /// 연도 (2026 …)
  year     Int      @id
  syncedAt DateTime @default(now())
}

/// 직접 넣은 휴일. 재량휴업일이나 학교 행사처럼 어떤 API 에도 없는 날을 위한 것이다.
///
/// 사람마다 따로 둔다. 같은 앱을 쓰더라도 다니는 학교가 다를 수 있어서,
/// 한 사람의 재량휴업일이 남의 달력까지 빨갛게 만들면 곤란하다.
model CustomHoliday {
  id   Int    @id @default(autoincrement())
  /// "YYYY-MM-DD"
  date String
  name String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 같은 사람이 같은 날을 두 번 넣지 못하게 한다.
  @@unique([userId, date])
  @@index([userId])
}
